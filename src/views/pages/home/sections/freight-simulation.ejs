<section class="freight-simulation">
  <h2>Simule seu Frete em Alguns Segundos!</h2>
  <p>Quer ter uma Estimativa de Quanto seu Frete vai custar?</p>
  <div class="conteiner">
    <div class="imagem">
      <img src="/images/img-freight-simulation.png" alt="imagem">
    </div>
    <div class="conteudo">
      <h3>Calcule o Frete da Sua Encomenda!</h3>
      <p>Informe o Cep de Origem e de Destino para começar.</p>
      <form action="/fretes/simular" method="POST">
        <div class="row">
          <div class="col">
            <label>Cep de Origem</label>
            <input type="text" class="form-control" name="cepOrigem" placeholder="Digite o Cep" aria-label="Cep Origem">
          </div>
          <div class="col">
            <label>Cep de Destino</label>
            <input type="text" class="form-control" name="cepDestino" placeholder="Digite o Cep" aria-label="Cep Destino">
          </div>
        </div>
        <br>
        <input type="submit" class="btn-orange" value="Calcular">
      </form>
      <div class="resultado">
        <p>Obs: É cobrado R$4.00 por Km. Cada ajudante adiciona ao total R$70.00</p>
      </div>
    </div>
  </div>
</section>