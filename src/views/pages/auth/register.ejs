<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= title %></title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet/less" type="text/css" href="/less/style.less" />
    <script src="https://cdn.jsdelivr.net/npm/less"></script>
  </head>
  <body page="register">
    <!-- Inclui o codigo HTML da navbar no inicio do body -->
    <%- include('../../partials/navbar.ejs') %>

    <main class="main-area">
      <div class="info-main-area">
        <div class="info-content">
          <h1 class="info-texts">
            <span class="info-text">Seu próximo frete</span>
            <span class="info-text highlight">começa aqui.</span>
          </h1>
          <p class="info-description">
            Conectando quem precisa enviar a quem faz chegar.
          </p>
        </div>
      </div>

      <div class="form-main-area">
        <div class="form-card">
          <h2 class="form-title">Crie sua conta</h2>
          <span class="form-description">Preencha os campos abaixo para criar sua conta.</span>
          <form id="auth-form">
            <div class="account-type">
              <span id="selected-type-background" class="selected-background"></span>
              <div class="account-options">
                <span class="form-check-label-type actived" option-id="0">Cliente</span>
                <span class="form-check-label-type" option-id="1">Motorista</span>
              </div>
            </div>
            <div id="form-elements">
            </div>
            <button id="submitBtn" type="submit" class="btn btn-orange mt-3">
              Cadastrar
            </button>
          </form>
          <div id="success-auth" class="d-none">
            Cadastro realizado com sucesso!
          </div>
        </div>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/f0c44ea109.js"></script>
    <script type="module" src="/js/auth/register.js"></script>
  </body>
</html>
