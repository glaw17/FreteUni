<%
  const currentPage = typeof navbarPage === "string" ? navbarPage : "";
  const isAuthPage = currentPage === "login" || currentPage === "register";
%>
<nav class="navbar navbar-light bg-light<%= user ? ' logged' : '' %><%= isAuthPage ? ' navbar-simple' : '' %>" aria-label="Navegação principal">
  <a class="navbar-brand" href="/">
    <img class="navbar-brand-img" src="/images/logo.png" alt="" />
    <span class="navbar-brand-text">
      Frete<span class="navbar-brand-text highlight-text">Uni</span>
    </span>
  </a>

  <% if (!isAuthPage) { %>
    <button type="button" class="navbar-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="navbar-menu navbar-search navbar-auth">
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>

    <div class="navbar-menu" id="navbar-menu">
      <a class="nav-link" href="/" <%- currentPage === "home" ? 'aria-current="page"' : '' %>>Início</a>
      <a class="nav-link" href="/contract" <%- currentPage === "contract" ? 'aria-current="page"' : '' %>>Contratação</a>
      <a class="nav-link" href="/#section-simulation">Simular</a>
      <a class="nav-link" href="/termos" <%- currentPage === "terms" ? 'aria-current="page"' : '' %>>Termos</a>
    </div>

    <form class="navbar-search" id="navbar-search" action="/rastrear" method="get" role="search"
      data-unavailable="O rastreamento de encomendas ainda não está disponível.">
      <label for="search-input" class="visually-hidden">Código de rastreio</label>
      <input id="search-input" name="id" type="search" class="form-control" placeholder="Código de rastreio" required maxlength="100" />
      <button id="track-btn" type="submit" class="btn btn-orange">Rastrear</button>
    </form>
  <% } %>

  <div class="navbar-auth" id="navbar-auth">
    <% if (currentPage === "login") { %>
      <a href="/register" class="btn btn-orange">Criar conta</a>
    <% } else if (currentPage === "register") { %>
      <a href="/login" class="btn btn-orange">Entrar</a>
    <% } else if (user) { %>
      <details class="profile-area">
        <summary class="profile">
          <span class="profile-name"><%= user.name %></span>
          <span class="profile-arrow" aria-hidden="true"><i class="fa-solid fa-angle-down"></i></span>
        </summary>
        <div class="profile-menu">
          <button type="button" id="logout-btn" class="profile-action">
            <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Sair
          </button>
          <p id="logout-error" class="profile-error" role="alert"></p>
        </div>
      </details>
    <% } else { %>
      <a href="/login" id="login-btn" class="btn btn-outline-dark">Entrar</a>
      <a href="/register" id="register-btn" class="btn btn-outline-orange">Criar Conta</a>
    <% } %>
  </div>
</nav>

<% if (!isAuthPage) { %>
  <div class="modal fade" id="navbar-unavailable" tabindex="-1" aria-labelledby="navbar-unavailable-title" aria-describedby="navbar-unavailable-description" aria-hidden="true">
    <div class="modal-dialog modal-sm">
      <div class="modal-content text-body">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="navbar-unavailable-title">Função indisponível</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <p class="mb-0 p-2" id="navbar-unavailable-description"></p>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/navbar.js" defer></script>
<% } %>
